# 로컬 실행용 환경변수 예시. 이 파일을 .env 로 복사한 뒤 값을 채우세요.
# (.env 는 .gitignore 에 의해 커밋되지 않습니다. 실제 값은 GitHub Secrets 에도 등록)

# flower.at.or.kr 서비스키 (필수) — 실제 값을 넣으세요(공개 레포에 커밋하지 말 것)
FLOWER_SERVICE_KEY=여기에_서비스키_입력

# 잔디 Incoming Webhook URL (발송 시 필수)
JANDI_WEBHOOK_URL=

# 대시보드 공개 URL (옵션, 잔디 메시지의 상세 링크로 사용)
# 예: https://내계정.github.io/flower-brief/
REPORT_BASE_URL=

# 과거 몇 경매일치를 대시보드에 생성할지 (옵션, 기본 20)
BACKFILL_DAYS=20

# ─────────────────────────────────────────────────────────────
# [화훼 뉴스 아침 브리핑] 전용 (경매 브리핑과 별개 시스템)
# ─────────────────────────────────────────────────────────────

# 뉴스 브리핑용 잔디 웹훅 (미설정 시 JANDI_WEBHOOK_URL 사용)
JANDI_NEWS_WEBHOOK_URL=

# (선택) data.go.kr 특일정보 서비스키 — 있으면 공휴일/대체공휴일 자동 최신화.
# 없으면 news_holiday.py 의 번들 공휴일표(2026~2027) 사용.
HOLIDAY_SERVICE_KEY=

# Claude Code 구독 토큰은 로컬 .env 가 아니라 GitHub Secret(CLAUDE_CODE_OAUTH_TOKEN)에 등록.
# 로컬에서 뉴스 생성을 테스트하려면 로그인된 claude CLI 를 그대로 사용하면 됩니다.
